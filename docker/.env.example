# ─── Keycloak ────────────────────────────────────────────────────────────────
KC_PORT=8080
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# ─── Gateway OAuth2 ──────────────────────────────────────────────────────────
GATEWAY_OAUTH2_ISSUER_URI=http://keycloak:8080/realms/don-moa
GATEWAY_OAUTH2_CLIENT_ID=don-moa-gateway
GATEWAY_OAUTH2_CLIENT_SECRET=<Keycloak > Clients > don-moa-gateway > Credentials 탭에서 복사>
GATEWAY_OAUTH2_SCOPES=openid,profile,email

# ─── Auth Service ─────────────────────────────────────────────────────────────
SERVER_PORT=8081

# PostgreSQL (auth_db)
DB_URL=jdbc:postgresql://<DB_HOST>:5432/auth_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Kafka
KAFKA_BOOTSTRAP_SERVERS=<KAFKA_HOST>:9092

# Keycloak Admin Client
KC_SERVER_URL=http://keycloak:8080
KC_REALM=don-moa
KC_ADMIN_CLIENT_ID=don-moa-admin
KC_ADMIN_CLIENT_SECRET=<Keycloak > Clients > don-moa-admin > Credentials 탭에서 복사>  # 필수 - 기본값 없음
KC_DIRECT_GRANT_CLIENT_ID=don-moa-gateway

# Profile Service 내부 주소
PROFILE_SERVICE_URL=http://<PROFILE_SERVICE_HOST>:8082

# Gateway Security (배포 시 true 권장)
APP_GATEWAY_SECURITY_ENABLED=false
APP_SECURITY_CONTEXT_SIGNING_KEY=<랜덤 HMAC 서명 키>
APP_SECURITY_CONTEXT_MAX_AGE_MILLIS=300000
