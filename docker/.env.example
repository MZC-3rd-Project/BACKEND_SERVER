# =====================================================================
# Local Development Environment Variables
# Copy to .env:  cp .env.example .env
# These defaults work with docker-compose.yml + don-moa-realm.json
# Production (AWS ECS) uses completely different values via Secrets Manager
# =====================================================================

# ─── Infrastructure Ports (host-mapped) ──────────────────────────────────────
POSTGRES_PORT=5432

# ─── Keycloak Admin Console ──────────────────────────────────────────────────
KC_PORT=43217
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# ─── Gateway OAuth2 (don-moa-gateway client) ─────────────────────────────────
GATEWAY_OAUTH2_ISSUER_URI=http://localhost:43217/realms/don-moa
GATEWAY_OAUTH2_CLIENT_ID=don-moa-gateway
GATEWAY_OAUTH2_CLIENT_SECRET=local-gateway-secret
GATEWAY_OAUTH2_SCOPES=openid,profile,email

# ─── Auth Service ────────────────────────────────────────────────────────────
SERVER_PORT=8081

# PostgreSQL (auth_db)
DB_URL=jdbc:postgresql://localhost:5432/auth_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Keycloak Admin Client (don-moa-admin client)
KC_SERVER_URL=http://localhost:43217
KC_REALM=don-moa
KC_ADMIN_CLIENT_ID=don-moa-admin
KC_ADMIN_CLIENT_SECRET=local-admin-secret
KC_DIRECT_GRANT_CLIENT_ID=don-moa-gateway

# Profile Service
PROFILE_SERVICE_URL=http://localhost:8082

# Gateway Security (local: disabled, production: enabled)
APP_GATEWAY_SECURITY_ENABLED=false

# HMAC Signing Key (generate with: openssl rand -base64 48)
# Leave empty for local dev; set in production for Gateway<->Service trust
APP_SECURITY_CONTEXT_SIGNING_KEY=
APP_SECURITY_CONTEXT_MAX_AGE_MILLIS=300000
