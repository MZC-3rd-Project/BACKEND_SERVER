aws_region       = "ap-northeast-2"
environment      = "dev"
name_prefix      = "donmoa"
cluster_version  = "1.31"

default_tags = {
  Team    = "backend"
  Managed = "terraform"
}

# Reuse outputs from infra/terraform/foundation
vpc_id = "vpc-xxxxxxxx"
# alb_security_group_id = "sg-xxxxxxxx"
# alb_to_node_ingress_ports = [8080]
# additional_lb_security_group_rules = [
#   {
#     source_security_group_id = "sg-prometheus-nlb"
#     from_port                = 9090
#     to_port                  = 9090
#     description              = "Prometheus internal NLB traffic"
#   }
# ]

private_subnet_ids = [
  "subnet-private-a",
  "subnet-private-b"
]

cluster_endpoint_private_access = true
cluster_endpoint_public_access  = true

cluster_endpoint_public_access_cidrs = [
  "<your-ip>/32"
]

node_group_instance_types = [
  "t3.large"
]

node_group_capacity_type = "ON_DEMAND"
node_group_desired_size  = 4
node_group_min_size      = 1
node_group_max_size      = 4

external_secrets_secret_arns = [
  "arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:donmoa/dev/*"
]

# Optional app runtime namespace / IRSA wiring
# application_namespace = "donmoa-dev"
# search_ai_enrichment_queue_arn = "arn:aws:sqs:ap-northeast-2:123456789012:donmoa-dev-search-ai-enrichment"
# cart_dynamodb_table_arn = "arn:aws:dynamodb:ap-northeast-2:123456789012:table/cart_items"
# media_s3_bucket_arn = "arn:aws:s3:::team2-donmoa-media-raw"
# media_service_account_names = ["media-api", "media-worker"]
