aws_region  = "ap-northeast-2"
environment = "dev"
name_prefix = "donmoa"

# Reuse output `node_security_group_id` from infra/terraform/eks-foundation
# when workloads run on EKS and need access to shared VPC dependencies.
# eks_node_security_group_id = "sg-xxxxxxxx"

default_tags = {
  Team    = "backend"
  Managed = "terraform"
}

vpc_cidr = "10.30.0.0/16"

public_subnet_cidrs = [
  "10.30.0.0/20",
  "10.30.16.0/20"
]

private_subnet_cidrs = [
  "10.30.128.0/20",
  "10.30.144.0/20"
]

enable_nat_gateway = true
single_nat_gateway = true
enable_private_subnet_network_acl = true
private_subnet_alb_target_ports   = [8080]

alb_ingress_cidrs       = ["0.0.0.0/0"]
create_alb              = true
gateway_container_port  = 8080
gateway_health_check_path = "/actuator/health"

# Core app image repositories
# Actual repository name = {name_prefix}-{environment}-{suffix}
ecr_repositories = [
  "client-gateway",
  "keycloak",
  "auth-service",
  "profile-service",
  "product-service",
  "stock-service",
  "sales-service",
  "funding-service",
  "hot-deal-service",
  "order-service",
  "payment-service",
  "review-service",
  "store-service",
  "store-query-service",
  "notification-service",
  "chat-service",
  "media-api",
  "media-worker",
  "analytics-dashboard-service",
  "cart-service"
]

# Aurora PostgreSQL (writer + reader)
enable_aurora                = true
aurora_engine_version        = "16.11"
aurora_database_name         = "commerce"
aurora_master_username       = "postgres"
aurora_instance_class        = "db.t4g.medium"
aurora_reader_instance_count = 1
aurora_backup_retention_days = 7

# Set only if you need deterministic password value.
# aurora_master_password = "<strong-password>"

# Redis (cost optimized default: single node)
enable_redis                      = true
redis_engine_version              = "7.1"
redis_node_type                   = "cache.t4g.small"
redis_num_cache_clusters          = 1
redis_at_rest_encryption_enabled  = true
redis_transit_encryption_enabled  = false

# EC2 single-node Kafka (MVP, cost-optimized)
enable_ec2_kafka          = true
ec2_kafka_instance_type   = "t3.small"
ec2_kafka_ebs_volume_size = 30

# Bastion EC2 (for local DB tools via SSH tunnel)
enable_ec2_bastion          = false
ec2_bastion_instance_type   = "t3.micro"
ec2_bastion_ebs_volume_size = 20
ec2_bastion_key_name        = "<existing-keypair-name>"
ec2_bastion_ingress_cidrs   = ["<your-ip>/32"]

# Optional EC2 single-node Elasticsearch (MVP)
enable_ec2_elasticsearch          = false
ec2_elasticsearch_instance_type   = "t3.small"
ec2_elasticsearch_ebs_volume_size = 30
ec2_elasticsearch_heap_size       = "512m"

# Optional managed stateful platform (cost heavy)
enable_msk        = false
enable_opensearch = false

# Optional search AI enrichment pipeline
enable_search_ai_enrichment = false
# search_ai_enrichment_bedrock_model_id = "anthropic.claude-3-haiku-20240307-v1:0"

# Example when enabling managed components
# enable_msk = true
# msk_broker_node_count = 2
# msk_instance_type = "kafka.t3.small"
#
# enable_opensearch = true
# opensearch_instance_type = "t3.small.search"
# opensearch_instance_count = 1
