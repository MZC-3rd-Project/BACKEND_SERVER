{
  "annotations": {
    "list": []
  },
  "description": "Request-centric drilldown dashboard for DonMoa logs.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "## Request Trace\nUse a regex-style request identifier. Default `.*` shows all request-linked logs.\n\n- `request_id` is used by `edge-nginx`\n- `requestId` is used by application JSON logs",
        "mode": "markdown"
      },
      "pluginVersion": "12.4.1",
      "title": "How to use",
      "transparent": true,
      "type": "text"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "__LOKI_UID__"
          },
          "expr": "{namespace=~\"$namespace\",service_name=\"edge-nginx\"} | json | request_id=~\"$request_id\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Edge Request Logs",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "__LOKI_UID__"
          },
          "expr": "{namespace=~\"$namespace\",service_name=~\"$service\"} | json | requestId=~\"$request_id\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Application Request Logs",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "__LOKI_UID__"
          },
          "expr": "sum by (service_name) (count_over_time({namespace=~\"$namespace\",service_name=~\"$service\"} | json | requestId=~\"$request_id\" [5m]))",
          "legendFormat": "{{service_name}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Application Request Volume by Service",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
