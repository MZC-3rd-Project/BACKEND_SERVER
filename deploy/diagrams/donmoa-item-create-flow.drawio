<mxfile host="app.diagrams.net" modified="2026-03-31T12:20:00Z" agent="Codex" version="24.7.17" type="device" compressed="false" pages="1">
  <diagram id="donmoa-item-create-flow" name="Item Create Flow">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="아이템 등록 플로우" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=34;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
          <mxGeometry x="60" y="32" width="1800" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Gateway BFF가 상품 생성, 이미지 등록, 상세 재조회를 하나의 흐름으로 묶어 응답하는 구조" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#475569;" parent="1" vertex="1">
          <mxGeometry x="220" y="84" width="1480" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="leftPanel" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="70" y="140" width="980" height="860" as="geometry"/>
        </mxCell>
        <mxCell id="rightPanel" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="1090" y="140" width="760" height="860" as="geometry"/>
        </mxCell>

        <mxCell id="leftBadge" value="메인 플로우" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="100" y="166" width="110" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="rightBadge" value="내부 처리 포인트" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#16A34A;strokeColor=#16A34A;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1120" y="166" width="140" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="flow1" value="1. Seller / Admin Client&#xa;POST /bff/v1/products" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#DBEAFE;strokeColor=#93C5FD;strokeWidth=2;fontColor=#1E3A8A;fontSize=22;fontStyle=1;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="220" y="240" width="680" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="flow2" value="2. Gateway BFF&#xa;BusinessProductMediaBffService&#xa;withAuthHeaders(true)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FEF3C7;strokeColor=#FCD34D;strokeWidth=2;fontColor=#92400E;fontSize=22;fontStyle=1;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="220" y="390" width="680" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="flow3" value="3. Product Service 호출&#xa;POST /api/products&#xa;ProductCommandController -&gt; ProductCommandService" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#111827;fontSize=22;fontStyle=1;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="220" y="560" width="680" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="flow4" value="4. 이미지가 있으면 추가 호출&#xa;POST /api/items/{itemId}/images&#xa;ItemImageCommandController -&gt; ItemImageCommandService" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#111827;fontSize=22;fontStyle=1;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="220" y="730" width="680" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="flow5" value="5. 상세 재조회&#xa;GET /api/seller/products/{itemId}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#111827;fontSize=22;fontStyle=1;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="220" y="900" width="680" height="88" as="geometry"/>
        </mxCell>

        <mxCell id="edge12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=4;" parent="1" source="flow1" target="flow2" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=4;" parent="1" source="flow2" target="flow3" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge34" value="선택" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=4;fontSize=14;fontStyle=1;fontColor=#1E3A8A;labelBackgroundColor=#FFFFFF;" parent="1" source="flow3" target="flow4" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=4;" parent="1" source="flow4" target="flow5" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="logic1" value="ProductCommandService 내부&#xa;- 판매자 store ownership 검증&#xa;- thumbnail media 참조 검증&#xa;- category 검증&#xa;- Item 저장&#xa;- ItemCreatedEvent 발행" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#334155;fontSize=20;fontStyle=1;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1130" y="250" width="680" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="logic2" value="이미지 단계 내부&#xa;- media 참조 검증&#xa;- ItemImage 저장&#xa;- 썸네일 / sortOrder 정규화&#xa;- MediaReferenceService로 링크 동기화&#xa;- ItemUpdatedEvent 발행" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#334155;fontSize=20;fontStyle=1;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1130" y="470" width="680" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="logic3" value="BFF 특징&#xa;- 이미지가 없으면 추가 단계 skip&#xa;- 생성/이미지 처리 후 상세 재조회&#xa;- 최종 응답은 클라이언트 친화 형태로 반환" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FEF3C7;strokeColor=#FCD34D;strokeWidth=2;fontColor=#92400E;fontSize=20;fontStyle=1;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1130" y="720" width="680" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="logic4" value="이후 비동기 검색 반영&#xa;- ItemCreatedEvent / ItemUpdatedEvent가 item-events로 발행&#xa;- Search ItemEventConsumer / SearchItemEventProcessor 처리&#xa;- ElasticsearchIndexingService가 문서 생성/갱신&#xa;- ElasticsearchDocumentClient가 색인 upsert" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ECFDF5;strokeColor=#86EFAC;strokeWidth=2;fontColor=#166534;fontSize=19;fontStyle=1;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1130" y="900" width="680" height="84" as="geometry"/>
        </mxCell>

        <mxCell id="asyncEdge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#16A34A;strokeWidth=3;" parent="1" source="flow3" target="logic4" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="asyncEdge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#16A34A;strokeWidth=3;" parent="1" source="flow4" target="logic4" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="summary" value="핵심: 클라이언트는 한 번의 BFF 요청만 보내고, Gateway가 상품 생성 - 이미지 등록 - 상세 재조회를 하나의 등록 플로우로 묶어 처리한다." style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=2;fontColor=#1E3A8A;fontSize=22;fontStyle=1;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="112" y="946" width="780" height="44" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
