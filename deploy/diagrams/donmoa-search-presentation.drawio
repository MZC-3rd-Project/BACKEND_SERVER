  <diagram id="search-es-setup" name="2. Elasticsearch Setup">
    <mxGraphModel dx="1111" dy="1131" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="2번 슬라이드. 그걸 위해 Elasticsearch를 이렇게 세팅했다" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=34;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
          <mxGeometry x="70" y="36" width="1780" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#DBEAFE;strokeColor=#93C5FD;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="80" y="150" width="560" height="310" as="geometry" />
        </mxCell>
        <mxCell id="p1t" value="설정 값" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#1E3A8A;" parent="1" vertex="1">
          <mxGeometry x="112" y="182" width="180" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p1x" value="- 검색 인덱스 주소와 이름을 설정 파일로 관리&#xa;- 기본값은 localhost:9200, index 이름은 items&#xa;- URI를 여러 개 둘 수 있지만 현재는 첫 번째 주소를 사용&#xa;- 예시 설정: search.elasticsearch.uris, index-name" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=21;fontColor=#1E3A8A;" parent="1" vertex="1">
          <mxGeometry x="112" y="236" width="500" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#FEF3C7;strokeColor=#FCD34D;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="680" y="150" width="560" height="310" as="geometry" />
        </mxCell>
        <mxCell id="p2t" value="인덱스 생성 방식" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#92400E;" parent="1" vertex="1">
          <mxGeometry x="712" y="182" width="220" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p2x" value="- 서비스가 인덱스 존재 여부를 직접 확인&#xa;- 없으면 코드에서 직접 인덱스 생성&#xa;- 중복 생성은 내부 플래그로 방지&#xa;- 운영 상황에서는 인덱스를 다시 만드는 기능도 제공&#xa;- 예시 코드: ElasticsearchDocumentClient" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=21;fontColor=#92400E;" parent="1" vertex="1">
          <mxGeometry x="712" y="236" width="500" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#ECFDF5;strokeColor=#86EFAC;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="1280" y="150" width="560" height="310" as="geometry" />
        </mxCell>
        <mxCell id="p3t" value="인덱스 세팅" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#166534;" parent="1" vertex="1">
          <mxGeometry x="1312" y="182" width="200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p3x" value="- shard 1개, replica 0개로 단순 구성&#xa;- 한글 검색을 위해 nori analyzer 사용&#xa;- 검색용 text와 필터용 keyword를 함께 사용&#xa;- 즉, 검색 품질과 exact match를 둘 다 고려한 세팅" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=21;fontColor=#166534;" parent="1" vertex="1">
          <mxGeometry x="1312" y="236" width="500" height="210" as="geometry" />
        </mxCell>
        <mxCell id="bottom" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="80" y="510" width="1760" height="430" as="geometry" />
        </mxCell>
        <mxCell id="bottomTitle" value="검색 문서 모델 ItemDocument" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
          <mxGeometry x="112" y="542" width="320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="기본 상품 정보&#xa;itemId, title, description, domainType, status, salesChannel, price" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="120" y="614" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="카테고리 / 스토어 정보&#xa;categoryId, category, categoryPath, categoryCodes, storeId, storeName" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="520" y="614" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="검색용 텍스트 필드&#xa;tags, features, detailTitles, detailDescriptions, detailHighlights" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="920" y="614" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="재고 / 판매 채널 정보&#xa;stock, availableStock, activeHotDealId, activeCampaignId" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="1320" y="614" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="AI enrichment 필드&#xa;aiTags, aiKeywords, aiSummary, aiSourceHash, aiModel, aiStatus, aiEnrichedAt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="320" y="772" width="520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="정렬 / 추적 필드&#xa;thumbnailMediaId, thumbnailUrl, sourceCreatedAt, sourceUpdatedAt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="980" y="772" width="520" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
