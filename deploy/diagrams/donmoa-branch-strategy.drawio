        <mxCell id="13" value="상위 이슈 연결&#xa;Related #issue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#60a5fa;strokeWidth=3;fontColor=#1e3a8a;fontSize=20;fontStyle=1;spacing=14;" parent="10" vertex="1">
          <mxGeometry x="30" y="355" width="370" height="90" as="geometry" />
        </mxCell>
        <mxCell id="14" value="핵심 메시지&#xa;작업 단위를 이슈 기준으로 쪼개고, 브랜치와 PR을 이슈에 묶어 추적한다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dbeafe;strokeColor=#93c5fd;strokeWidth=2;fontColor=#1e3a8a;fontSize=18;spacing=14;" parent="10" vertex="1">
          <mxGeometry x="30" y="490" width="370" height="95" as="geometry" />
        </mxCell>
        <mxCell id="20" value="2. 브랜치 생성 규칙" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#f0fdf4;strokeColor=#15803d;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#166534;align=left;verticalAlign=top;spacing=14;" parent="1" vertex="1">
          <mxGeometry x="520" y="150" width="760" height="610" as="geometry" />
        </mxCell>
        <mxCell id="21" value="브랜치 시작점&#xa;issue 생성 후 바로 작업 브랜치 생성" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=3;fontColor=#166534;fontSize=21;fontStyle=1;spacing=14;" parent="20" vertex="1">
          <mxGeometry x="220" y="70" width="320" height="95" as="geometry" />
