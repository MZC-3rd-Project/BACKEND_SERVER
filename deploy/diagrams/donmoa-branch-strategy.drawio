  <diagram id="branch-strategy-main" name="브랜치 전략">
    <mxGraphModel dx="4800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="DonMoa 브랜치 전략" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=34;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
          <mxGeometry x="50" y="26" width="680" height="46" as="geometry" />
        </mxCell>
        <mxCell id="3" value="이슈 생성부터 작업 브랜치, PR, CI, develop 통합, main 승격까지 발표용으로 한 장에 정리" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#4b5563;" parent="1" vertex="1">
