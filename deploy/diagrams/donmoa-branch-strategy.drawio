        <mxCell id="24" value="task/{issue}-{description}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#ffffff;strokeColor=#4ade80;strokeWidth=3;fontColor=#166534;fontSize=19;fontStyle=1;spacing=12;" parent="20" vertex="1">
