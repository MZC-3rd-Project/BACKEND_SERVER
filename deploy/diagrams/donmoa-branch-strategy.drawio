        <mxCell id="10" value="1. 이슈 관리" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#1e3a8a;align=left;verticalAlign=top;spacing=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="150" width="430" height="610" as="geometry" />
        </mxCell>
        <mxCell id="11" value="GitHub Issue + Jira Sync&#xa;생성/수정/닫기 이벤트를 기준으로 추적" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=3;fontColor=#1e3a8a;fontSize=22;fontStyle=1;spacing=14;" parent="10" vertex="1">
          <mxGeometry x="30" y="70" width="370" height="110" as="geometry" />
