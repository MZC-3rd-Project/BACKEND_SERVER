        <mxCell id="30" value="3. 개발 · PR · 통합 흐름" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#9a3412;align=left;verticalAlign=top;spacing=14;" parent="1" vertex="1">
          <mxGeometry x="1380" y="130" width="1020" height="750" as="geometry" />
        </mxCell>
        <mxCell id="31" value="Conventional Commit&#xa;feat / fix / refactor / ci / docs / test" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#f97316;strokeWidth=3;fontColor=#9a3412;fontSize=21;fontStyle=1;spacing=14;" parent="30" vertex="1">
          <mxGeometry x="40" y="90" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="32" value="PR 생성 대상&#xa;develop" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#fb923c;strokeWidth=3;fontColor=#9a3412;fontSize=23;fontStyle=1;spacing=14;" parent="30" vertex="1">
          <mxGeometry x="370" y="90" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="33" value="필수 체크&#xa;Build &amp; Test&#xa;Code Style" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#fdba74;strokeWidth=3;fontColor=#9a3412;fontSize=21;fontStyle=1;spacing=14;" parent="30" vertex="1">
          <mxGeometry x="670" y="90" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="34" value="PR 본문&#xa;Closes #issue&#xa;또는 Fixes #issue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#f59e0b;strokeWidth=3;fontColor=#92400e;fontSize=21;fontStyle=1;spacing=14;" parent="30" vertex="1">
          <mxGeometry x="180" y="290" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="35" value="Merge to develop&#xa;통합 브랜치에 반영" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=3;fontColor=#9a3412;fontSize=23;fontStyle=1;spacing=14;" parent="30" vertex="1">
          <mxGeometry x="520" y="290" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="36" value="Release / Final Promote&#xa;main" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=3;fontColor=#9f1239;fontSize=23;fontStyle=1;spacing=14;" parent="30" vertex="1">
          <mxGeometry x="520" y="500" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="38" value="발표용 해석&#xa;저장소에서 확정된 규칙은 develop 대상 PR이며, main은 최종 릴리스/완료 브랜치로 설명하면 자연스럽다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#f9fafb;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#334155;fontSize=17;spacing=14;" parent="30" vertex="1">
          <mxGeometry x="40" y="670" width="930" height="60" as="geometry" />
        </mxCell>
        <mxCell id="106" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#111827;strokeWidth=6;" parent="30" source="31" target="32" edge="1">
          <mxGeometry relative="1" as="geometry" />
