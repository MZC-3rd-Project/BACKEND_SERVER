        <mxCell id="12" value="Issue 계층&#xa;Epic / Story / Task / Bugfix" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=3;fontColor=#1e3a8a;fontSize=21;fontStyle=1;spacing=14;" parent="10" vertex="1">
          <mxGeometry x="30" y="220" width="370" height="95" as="geometry" />
