  </diagram>
  <diagram id="branch-strategy-talk" name="발표 포인트">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="브랜치 전략 발표 포인트" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=32;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
          <mxGeometry x="40" y="24" width="660" height="44" as="geometry" />
        </mxCell>
        <mxCell id="3" value="브랜치 네이밍 규칙과 협업 흐름을 1분 안에 설명할 수 있도록 만든 보조 페이지" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#4b5563;" parent="1" vertex="1">
          <mxGeometry x="44" y="70" width="980" height="28" as="geometry" />
        </mxCell>
        <mxCell id="10" value="30초 버전" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=3;fontColor=#1e3a8a;fontSize=24;fontStyle=1;spacing=14;" parent="1" vertex="1">
          <mxGeometry x="60" y="150" width="2080" height="200" as="geometry" />
        </mxCell>
        <mxCell id="11" value="저희는 이슈를 Epic, Story, Task 단위로 나누고, 각 이슈에서 규칙 있는 작업 브랜치를 파생시켰습니다. 커밋도 Conventional Commit으로 맞추고 PR은 develop으로만 모아서 Build, Test, 스타일 검사를 통과해야 머지되도록 운영했습니다. 그래서 협업할 때 누가 어떤 맥락의 작업을 하는지와 머지 기준이 항상 명확했습니다." style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=2;fontColor=#334155;fontSize=23;spacing=16;" parent="10" vertex="1">
          <mxGeometry x="24" y="58" width="2032" height="116" as="geometry" />
        </mxCell>
        <mxCell id="20" value="왜 이 전략이 필요한가?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f0fdf4;strokeColor=#15803d;strokeWidth=3;fontColor=#166534;fontSize=24;fontStyle=1;spacing=14;" parent="1" vertex="1">
          <mxGeometry x="60" y="420" width="680" height="360" as="geometry" />
        </mxCell>
        <mxCell id="21" value="1. 작업 단위를 잘게 나눠서 병렬 개발 충돌을 줄인다&#xa;2. 브랜치 이름만 봐도 이슈 번호와 작업 성격이 보인다&#xa;3. PR 기준이 develop 하나라서 리뷰 흐름이 단순하다&#xa;4. 이슈 종료와 Jira 상태 동기화까지 이어져 운영 관리가 쉽다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#86efac;strokeWidth=2;fontColor=#334155;fontSize=21;spacing=14;" parent="20" vertex="1">
          <mxGeometry x="24" y="56" width="632" height="260" as="geometry" />
        </mxCell>
        <mxCell id="30" value="면접 / 발표에서 강조할 말" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=3;fontColor=#9a3412;fontSize=24;fontStyle=1;spacing=14;" parent="1" vertex="1">
          <mxGeometry x="780" y="420" width="660" height="360" as="geometry" />
        </mxCell>
        <mxCell id="31" value="규칙이 있는 브랜치 전략은 단순히 깔끔해 보이기 위한 것이 아니라, 리뷰 비용을 줄이고 CI 기준을 명확히 해서 팀 개발 속도를 안정화하는 장치라고 설명하면 좋다." style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#fdba74;strokeWidth=2;fontColor=#334155;fontSize=22;spacing=16;" parent="30" vertex="1">
          <mxGeometry x="24" y="56" width="612" height="120" as="geometry" />
        </mxCell>
        <mxCell id="32" value="짧은 강조 키워드&#xa;이슈 기반 분리 / develop 중심 통합 / CI 통과 후 머지 / 이슈-PR-Jira 연결" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#fed7aa;strokeWidth=2;fontColor=#334155;fontSize=21;spacing=14;" parent="30" vertex="1">
          <mxGeometry x="24" y="210" width="612" height="110" as="geometry" />
        </mxCell>
        <mxCell id="40" value="질의응답 대비" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ecfeff;strokeColor=#0891b2;strokeWidth=3;fontColor=#155e75;fontSize=24;fontStyle=1;spacing=14;" parent="1" vertex="1">
          <mxGeometry x="1480" y="420" width="660" height="360" as="geometry" />
        </mxCell>
        <mxCell id="41" value="Q. 왜 develop으로만 PR을 모았나?&#xa;A. 통합 기준점을 하나로 두면 리뷰어와 CI 파이프라인의 판단이 단순해진다." style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#67e8f9;strokeWidth=2;fontColor=#334155;fontSize=20;spacing=14;" parent="40" vertex="1">
          <mxGeometry x="24" y="56" width="612" height="92" as="geometry" />
        </mxCell>
        <mxCell id="42" value="Q. main은 언제 쓰나?&#xa;A. 저장소 문서상 PR 기준은 develop이 확정이고, 발표에서는 main을 최종 릴리스 승격 브랜치로 설명하면 된다." style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#a5f3fc;strokeWidth=2;fontColor=#334155;fontSize=20;spacing=14;" parent="40" vertex="1">
          <mxGeometry x="24" y="172" width="612" height="92" as="geometry" />
        </mxCell>
        <mxCell id="43" value="Q. 규칙이 실제로 도움이 되나?&#xa;A. 브랜치 이름, PR 제목, 커밋 메시지만 봐도 변경 의도를 빠르게 파악할 수 있어서 리뷰 속도와 추적성이 좋아진다." style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#cffafe;strokeWidth=2;fontColor=#334155;fontSize=20;spacing=14;" parent="40" vertex="1">
          <mxGeometry x="24" y="288" width="612" height="92" as="geometry" />
        </mxCell>
        <mxCell id="50" value="추천 장표 순서" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f9fafb;strokeColor=#111827;strokeWidth=2;fontSize=24;fontStyle=1;fontColor=#111827;align=left;verticalAlign=top;spacing=14;" parent="1" vertex="1">
          <mxGeometry x="120" y="900" width="1960" height="280" as="geometry" />
        </mxCell>
        <mxCell id="51" value="1. 프로젝트 개요" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#334155;fontSize=20;spacing=12;" parent="50" vertex="1">
          <mxGeometry x="40" y="80" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="52" value="2. 아키텍처" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#334155;fontSize=20;spacing=12;" parent="50" vertex="1">
          <mxGeometry x="360" y="80" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="53" value="3. 브랜치 전략" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#dbeafe;strokeColor=#60a5fa;strokeWidth=2;fontColor=#1e3a8a;fontSize=20;fontStyle=1;spacing=12;" parent="50" vertex="1">
          <mxGeometry x="680" y="80" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="54" value="4. CI/CD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#334155;fontSize=20;spacing=12;" parent="50" vertex="1">
          <mxGeometry x="1000" y="80" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="55" value="5. 운영 / 보안" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontColor=#334155;fontSize=20;spacing=12;" parent="50" vertex="1">
          <mxGeometry x="1320" y="80" width="280" height="70" as="geometry" />
        </mxCell>
