        <mxCell id="23" value="story/{issue}-{description}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#ffffff;strokeColor=#22c55e;strokeWidth=3;fontColor=#166534;fontSize=19;fontStyle=1;spacing=12;" parent="20" vertex="1">
          <mxGeometry x="420" y="240" width="300" height="85" as="geometry" />
