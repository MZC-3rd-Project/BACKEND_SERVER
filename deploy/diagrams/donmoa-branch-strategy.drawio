        <mxCell id="26" value="브랜치 네이밍 규칙&#xa;작업 종류와 이슈 번호가 이름에 바로 드러나서 협업과 리뷰가 쉬워진다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dcfce7;strokeColor=#86efac;strokeWidth=2;fontColor=#166534;fontSize=18;spacing=14;" parent="20" vertex="1">
          <mxGeometry x="100" y="500" width="560" height="90" as="geometry" />
