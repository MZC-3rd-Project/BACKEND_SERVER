  <diagram id="pipeline-talk" name="발표 포인트">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="2" value="CI/CD 발표 포인트" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=32;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
          <mxGeometry x="40" y="26" width="620" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="스크립트명보다 ‘무슨 흐름으로 자동화했는가’를 강조하는 발표 보조 페이지" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#4b5563;" parent="1" vertex="1">
          <mxGeometry x="44" y="72" width="980" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="10" value="한 줄 설명" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=3;fontColor=#1e3a8a;fontSize=24;fontStyle=1;spacing=14;" parent="1" vertex="1">
          <mxGeometry x="60" y="150" width="2080" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="GitHub에서 변경이 들어오면 변경 파일과 서비스 카탈로그, 의존성 그래프를 기준으로 영향 받는 서비스만 골라서 빌드하고, 그 이미지들만 EKS에 배포하도록 구성했습니다." style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=2;fontColor=#334155;fontSize=23;spacing=16;" parent="10" vertex="1">
          <mxGeometry x="24" y="58" width="2032" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="20" value="왜 좋은가?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f0fdf4;strokeColor=#15803d;strokeWidth=3;fontColor=#166534;fontSize=24;fontStyle=1;spacing=14;" parent="1" vertex="1">
          <mxGeometry x="60" y="400" width="980" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="1. 전체를 매번 다시 배포하지 않아서 빠르다&#xa;2. 변경 범위가 명확해서 운영 리스크가 줄어든다&#xa;3. ECR에도 필요한 이미지들만 올라간다&#xa;4. client-gateway는 Blue/Green, 그 외 서비스는 Rollout으로 분리 운영한다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#86efac;strokeWidth=2;fontColor=#334155;fontSize=21;spacing=14;" parent="20" vertex="1">
          <mxGeometry x="24" y="56" width="932" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="30" value="교수님 질문 대응" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=3;fontColor=#9a3412;fontSize=24;fontStyle=1;spacing=14;" parent="1" vertex="1">
          <mxGeometry x="1160" y="400" width="980" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="Q. 배포 전략은 모두 같은가?&#xa;A. 아닙니다. client-gateway는 외부 진입점이라 Blue/Green으로 안정성을 우선했고, 그 외 서비스는 Rollout 기반으로 운영했습니다.&#xa;&#xa;Q. 영향 서비스는 어떻게 고르나?&#xa;A. 변경 파일, 서비스 카탈로그, 의존성 그래프를 기준으로 이번 변경의 파급 범위를 계산합니다." style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#fdba74;strokeWidth=2;fontColor=#334155;fontSize=20;spacing=14;" parent="30" vertex="1">
          <mxGeometry x="24" y="56" width="932" height="220" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
