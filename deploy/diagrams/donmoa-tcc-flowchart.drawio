          <mxGeometry x="650" y="390" width="250" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="submit" value="구매 저장 / 주문 생성 / 결제 진행&#xa;Checkout submit → Order Service → Payment Service" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontColor=#334155;fontSize=18;fontStyle=1;spacing=10;" parent="leftPanel" vertex="1">
