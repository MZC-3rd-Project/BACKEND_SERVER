        <mxCell id="title" value="DonMoa TCC Purchase Flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=32;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
          <mxGeometry x="40" y="24" width="700" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="재고가 필요한 구매는 먼저 예약하고(Try), 결제 결과에 따라 확정(Confirm)하거나 복구(Cancel)하는 흐름" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#4b5563;" parent="1" vertex="1">
          <mxGeometry x="44" y="70" width="1200" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="leftPanel" value="Synchronous Guard Rail" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#fff7ed;strokeColor=#fdba74;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#9a3412;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="130" width="980" height="900" as="geometry"/>
        </mxCell>
        <mxCell id="rightPanel" value="Async State Propagation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#1d4ed8;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1080" y="130" width="1060" height="900" as="geometry"/>
        </mxCell>

        <mxCell id="scope1" value="적용 범위: QUANTITY_BASED 구매 흐름에만 TCC 적용" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#fed7aa;strokeWidth=1;fontColor=#7c2d12;fontSize=17;fontStyle=1;spacing=10;" parent="leftPanel" vertex="1">
          <mxGeometry x="24" y="52" width="450" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="scope2" value="서비스 간 최종 상태 전파는 payment-events 기반 Saga로 분리" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#bfdbfe;strokeWidth=1;fontColor=#1e3a8a;fontSize=17;fontStyle=1;spacing=10;" parent="rightPanel" vertex="1">
          <mxGeometry x="24" y="52" width="520" height="46" as="geometry"/>
        </mxCell>

        <mxCell id="start" value="구매 시작&#xa;CheckoutCommandService&#xa;HotDealCheckoutService" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#f59e0b;strokeWidth=2;fontColor=#7c2d12;fontSize=18;fontStyle=1;spacing=10;" parent="leftPanel" vertex="1">
          <mxGeometry x="60" y="180" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="validate" value="상품 / 수량 검증" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontColor=#334155;fontSize=18;fontStyle=1;spacing=10;" parent="leftPanel" vertex="1">
          <mxGeometry x="350" y="202" width="180" height="66" as="geometry"/>
