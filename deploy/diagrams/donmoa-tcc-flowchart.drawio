        </mxCell>

        <mxCell id="stateTitle" value="TCC 상태 전이" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#9a3412;" parent="leftPanel" vertex="1">
          <mxGeometry x="60" y="760" width="220" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="stateTry" value="Try&#xa;available → reserved" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#fff7ed;strokeColor=#fdba74;strokeWidth=2;fontColor=#9a3412;fontSize=17;fontStyle=1;spacing=10;" parent="leftPanel" vertex="1">
          <mxGeometry x="60" y="810" width="220" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="stateConfirm" value="Confirm&#xa;reserved → sold" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ecfdf5;strokeColor=#86efac;strokeWidth=2;fontColor=#166534;fontSize=17;fontStyle=1;spacing=10;" parent="leftPanel" vertex="1">
          <mxGeometry x="360" y="810" width="220" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="stateCancel" value="Cancel / Expire&#xa;reserved → available" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#fef2f2;strokeColor=#fca5a5;strokeWidth=2;fontColor=#991b1b;fontSize=17;fontStyle=1;spacing=10;" parent="leftPanel" vertex="1">
          <mxGeometry x="660" y="810" width="240" height="96" as="geometry"/>
        </mxCell>

        <mxCell id="eventBus" value="Kafka Topic&#xa;payment-events" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#0f172a;strokeColor=#0f172a;strokeWidth=2;fontColor=#ffffff;fontSize=20;fontStyle=1;spacing=10;" parent="rightPanel" vertex="1">
          <mxGeometry x="390" y="180" width="250" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="orderConsumer" value="OrderPaymentEventProcessor&#xa;PAYMENT_COMPLETED → PAID&#xa;FAILED/CANCELLED/TIMED_OUT → CANCELLED&#xa;PAYMENT_REFUNDED → REFUNDED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#818cf8;strokeWidth=2;fontColor=#312e81;fontSize=17;fontStyle=1;spacing=10;" parent="rightPanel" vertex="1">
          <mxGeometry x="70" y="400" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="stockConsumer" value="StockPaymentEventProcessor&#xa;PAYMENT_COMPLETED → confirmReservationsByOrderId()&#xa;FAILED/CANCELLED/TIMED_OUT/REFUNDED → cancelReservationsByOrderId()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#34d399;strokeWidth=2;fontColor=#166534;fontSize=17;fontStyle=1;spacing=10;" parent="rightPanel" vertex="1">
          <mxGeometry x="400" y="400" width="360" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="channelConsumer" value="Channel Consumers&#xa;HotDealPaymentEventProcessor → confirmOrder()/cancelByOrderId()&#xa;FundingPaymentEventProcessor → syncPaymentCompleted()/syncPaymentRefunded()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#60a5fa;strokeWidth=2;fontColor=#1d4ed8;fontSize=17;fontStyle=1;spacing=10;" parent="rightPanel" vertex="1">
          <mxGeometry x="790" y="400" width="240" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="branchNote" value="Failure branch&#xa;결제 실패/취소/타임아웃/환불이 오면 각 서비스는 같은 orderId 기준으로 취소, 복원, 세션 해제, 상태 환불 반영만 수행" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#ffffff;strokeColor=#bfdbfe;strokeWidth=1;fontColor=#1e3a8a;fontSize=16;spacing=10;" parent="rightPanel" vertex="1">
          <mxGeometry x="70" y="660" width="960" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="tradeoff" value="Trade-off&#xa;초과 판매는 줄일 수 있지만 reserved 상태와 TTL, 복구 로직을 직접 관리해야 해서 단순 CRUD보다 구조가 복잡해진다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#fff7ed;strokeColor=#fdba74;strokeWidth=2;fontColor=#9a3412;fontSize=18;fontStyle=1;spacing=12;" parent="rightPanel" vertex="1">
