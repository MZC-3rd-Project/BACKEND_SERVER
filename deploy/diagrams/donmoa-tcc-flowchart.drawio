          <mxGeometry x="590" y="202" width="180" height="66" as="geometry"/>
        </mxCell>

        <mxCell id="try" value="Try&#xa;StockCommandService.reserveOrderStock()&#xa;available → reserved&#xa;orderId + expiresAt + idempotencyKey" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#fff7ed;strokeColor=#fb923c;strokeWidth=2;fontColor=#9a3412;fontSize=18;fontStyle=1;spacing=10;" parent="leftPanel" vertex="1">
          <mxGeometry x="210" y="360" width="410" height="140" as="geometry"/>
        </mxCell>
