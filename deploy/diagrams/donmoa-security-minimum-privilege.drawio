        </mxCell>
        <mxCell id="53" value="Public API endpoint&#xa;182.208.131.42/32 only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#7c2d12;fontSize=13;fontStyle=1;spacing=8;" parent="21" vertex="1">
