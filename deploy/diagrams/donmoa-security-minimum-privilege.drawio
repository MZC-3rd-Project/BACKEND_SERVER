          <mxGeometry x="50" y="360" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="41" value="- Private subnet NACL 적용&#xa;- Public subnet CIDR -&gt; 8080만 허용&#xa;- ephemeral return / VPC east-west / DNS / NAT egress만 허용" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#334155;fontSize=14;spacing=10;" parent="40" vertex="1">
          <mxGeometry x="20" y="110" width="440" height="96" as="geometry" />
        </mxCell>
        <mxCell id="60" value="발표 시 주의 문구" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ecfeff;strokeColor=#06b6d4;fontColor=#155e75;fontSize=18;fontStyle=1;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1110" y="360" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="61" value="&quot;네트워크 보안 관점에서는 최소 권한 원칙에 맞춰&#xa;공개 범위와 접근 소스를 소스 SG 기반으로 제한했다&quot;&#xa;라고 말하는 것이 가장 정확함" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#a5f3fc;fontColor=#334155;fontSize=14;spacing=10;" parent="60" vertex="1">
          <mxGeometry x="20" y="100" width="440" height="96" as="geometry" />
        </mxCell>
        <mxCell id="21" value="- ALB Frontend SG -&gt; Worker SG 8080만 허용&#xa;- Worker SG -&gt; Aurora 5432, Redis 6379, Kafka 9092, ES 9200&#xa;- source SG chaining으로 흐름을 제한" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#bfdbfe;fontColor=#334155;fontSize=14;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="590" y="230" width="440" height="96" as="geometry" />
        </mxCell>
        <mxCell id="31" value="- Prometheus internal NLB는 9090만&#xa;- Loki internal NLB는 3100만&#xa;- shared backend SG는 끄고, 각 NLB frontend SG만 worker에 명시 허용" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#bbf7d0;fontColor=#334155;fontSize=14;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1130" y="230" width="440" height="96" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
