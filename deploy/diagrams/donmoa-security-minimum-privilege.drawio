        <mxCell id="100" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#64748b;strokeWidth=2;fontSize=12;fontColor=#334155;" parent="1" source="10" target="11" edge="1">
