          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="113" value="443 / 10250 / 9443" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#f59e0b;strokeWidth=2;fontSize=12;fontColor=#92400e;" parent="21" source="52" target="39" edge="1">
          <mxGeometry relative="1" as="geometry" />
