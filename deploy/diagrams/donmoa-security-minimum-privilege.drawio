        <mxCell id="51" value="2차 방어선&#xa;- Public subnet CIDR -&gt; 8080 only&#xa;- Ephemeral return traffic 허용&#xa;- VPC east-west 허용&#xa;- DNS(53) + NAT egress 허용" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#334155;fontSize=14;spacing=10;" parent="50" vertex="1">
          <mxGeometry x="24" y="60" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="52" value="EKS Control Plane" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;html=1;outlineConnect=0;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="21" vertex="1">
