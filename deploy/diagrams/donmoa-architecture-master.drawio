          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="60" value="왜 2 AZ로 구성했는가?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=18;fontStyle=1;spacing=12;" parent="21" vertex="1">
          <mxGeometry x="1430" y="180" width="380" height="56" as="geometry" />
        </mxCell>
        <mxCell id="61" value="1. 단일 AZ 장애가 나도 다른 AZ 노드에서 서비스 지속&#xa;2. ALB가 두 Public Subnet을 사용해 트래픽 우회 가능&#xa;3. 운영 / 확장 / 롤링 배포 시 안정성이 높음&#xa;4. 실제 Terraform도 Public / Private Subnet을 각각 2개로 두고, EKS는 private_subnet_ids 최소 2개를 요구" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#f8fafc;strokeColor=#0f172a;fontColor=#334155;fontSize=13;spacing=12;" parent="21" vertex="1">
          <mxGeometry x="1430" y="250" width="430" height="190" as="geometry" />
        </mxCell>
        <mxCell id="70" value="AWS 관리 서비스" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#f7fff9;strokeColor=#86efac;fontColor=#14532d;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=12;" parent="21" vertex="1">
          <mxGeometry x="1460" y="520" width="360" height="390" as="geometry" />
        </mxCell>
        <mxCell id="71" value="Amazon S3" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;html=1;outlineConnect=0;gradientColor=#60A337;gradientDirection=north;fillColor=#277116;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="70" vertex="1">
          <mxGeometry x="40" y="70" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="72" value="DynamoDB" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;html=1;outlineConnect=0;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="70" vertex="1">
          <mxGeometry x="150" y="70" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="73" value="Amazon ECR" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;html=1;outlineConnect=0;gradientColor=#945DF2;gradientDirection=north;fillColor=#5A30B5;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="70" vertex="1">
          <mxGeometry x="260" y="70" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="74" value="Secrets Manager" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;html=1;outlineConnect=0;gradientColor=#F54749;gradientDirection=north;fillColor=#C7131F;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="70" vertex="1">
          <mxGeometry x="40" y="210" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="75" value="여기는 애플리케이션이 직접 소비하는 backing service 계층입니다.&#xa;Aurora는 기본 OLTP 저장소, Redis는 세션/캐시, DynamoDB는 cart 전용, S3는 media 저장, ECR/Secrets는 배포와 런타임 운영을 지원합니다." style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#bbf7d0;fontColor=#14532d;fontSize=13;spacing=10;" parent="70" vertex="1">
          <mxGeometry x="135" y="198" width="205" height="116" as="geometry" />
        </mxCell>
        <mxCell id="100" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#64748b;strokeWidth=2;" parent="1" source="10" target="11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="101" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#64748b;strokeWidth=2;" parent="1" source="11" target="23" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
