        <mxCell id="46" value="Amazon S3" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;html=1;outlineConnect=0;gradientColor=#60A337;gradientDirection=north;fillColor=#277116;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="1" vertex="1">
