        <mxCell id="102" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#2563eb;strokeWidth=2;" parent="1" source="22" target="32" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="103" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#2563eb;strokeWidth=2;" parent="1" source="22" target="33" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="explainer-service" name="서비스 아키텍처">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="DonMoa 서비스 아키텍처" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#0f172a;" parent="1" vertex="1">
          <mxGeometry x="40" y="24" width="520" height="42" as="geometry" />
        </mxCell>
        <mxCell id="3" value="설명용 / 도메인 역할과 큰 흐름 중심" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#475569;" parent="1" vertex="1">
          <mxGeometry x="44" y="68" width="420" height="26" as="geometry" />
        </mxCell>

        <mxCell id="10" value="사용자" style="shape=mxgraph.aws4.users;html=1;strokeColor=none;fillColor=#232F3E;gradientColor=none;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="70" y="180" width="84" height="84" as="geometry" />
        </mxCell>
        <mxCell id="11" value="CloudFront" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;html=1;outlineConnect=0;gradientColor=#945DF2;gradientDirection=north;fillColor=#5A30B5;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="250" y="170" width="84" height="84" as="geometry" />
        </mxCell>
        <mxCell id="12" value="ALB" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;html=1;outlineConnect=0;gradientColor=#945DF2;gradientDirection=north;fillColor=#5A30B5;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="420" y="170" width="84" height="84" as="geometry" />
        </mxCell>
        <mxCell id="13" value="client-gateway" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#dbeafe;strokeColor=#60a5fa;fontColor=#1e3a8a;fontSize=16;fontStyle=1;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="610" y="168" width="250" height="78" as="geometry" />
        </mxCell>
        <mxCell id="14" value="Keycloak" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#eff6ff;strokeColor=#93c5fd;fontColor=#1e3a8a;fontSize=15;fontStyle=1;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="930" y="168" width="170" height="78" as="geometry" />
        </mxCell>
        <mxCell id="15" value="발표 멘트&#xa;외부 요청은 client-gateway로 모이고, 인증 경계는 Keycloak이 담당합니다." style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=13;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1160" y="160" width="360" height="92" as="geometry" />
        </mxCell>

        <mxCell id="20" value="인증 / 사용자 도메인&#xa;auth-service&#xa;profile-service" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#fef2f2;strokeColor=#fca5a5;fontColor=#7f1d1d;fontSize=16;fontStyle=1;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="140" y="390" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="21" value="상품 / 커머스 도메인&#xa;product / stock / funding / sales / hot-deal&#xa;store / store-query" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#fff7ed;strokeColor=#fdba74;fontColor=#7c2d12;fontSize=16;fontStyle=1;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="560" y="390" width="430" height="160" as="geometry" />
        </mxCell>
        <mxCell id="22" value="주문 / 고객경험 도메인&#xa;cart / order / payment / review&#xa;chat / notification" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#f0fdf4;strokeColor=#86efac;fontColor=#14532d;fontSize=16;fontStyle=1;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1050" y="390" width="410" height="160" as="geometry" />
        </mxCell>
        <mxCell id="23" value="검색 / 미디어 / 분석 도메인&#xa;search / media-api / media-worker&#xa;analytics-dashboard" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ecfeff;strokeColor=#67e8f9;fontColor=#155e75;fontSize=16;fontStyle=1;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1520" y="390" width="410" height="160" as="geometry" />
        </mxCell>

        <mxCell id="30" value="어떻게 설명하면 좋은가?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="140" y="620" width="1790" height="170" as="geometry" />
        </mxCell>
        <mxCell id="31" value="1. client-gateway가 외부 요청을 받아 적절한 도메인으로 나눈다고 설명&#xa;2. 서비스는 책임 기준으로 4개 블록으로 묶여 있다고 설명&#xa;3. 저장소는 업무 특성에 맞게 나뉜다고 설명: Aurora(기본), Redis(세션/캐시), DynamoDB(cart), S3(media), Search Engine(search)&#xa;4. 화살표는 세부 구현보다 큰 흐름만 보여준다고 설명" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=14;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="170" y="665" width="1730" height="98" as="geometry" />
        </mxCell>

        <mxCell id="40" value="공유 플랫폼" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="140" y="860" width="1790" height="240" as="geometry" />
        </mxCell>
        <mxCell id="41" value="Aurora" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;html=1;outlineConnect=0;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="250" y="935" width="84" height="84" as="geometry" />
        </mxCell>
        <mxCell id="42" value="ElastiCache" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticache;html=1;outlineConnect=0;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="500" y="935" width="84" height="84" as="geometry" />
        </mxCell>
        <mxCell id="43" value="Kafka / Event" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#334155;fontSize=13;fontStyle=1;spacing=8;" parent="1" vertex="1">
