<mxfile host="app.diagrams.net" modified="2026-03-26T13:05:00.000Z" agent="Codex" version="24.7.17" type="device" pages="2">
  <diagram id="explainer-cloud" name="클라우드 아키텍처">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="DonMoa 클라우드 아키텍처" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#0f172a;" parent="1" vertex="1">
          <mxGeometry x="40" y="24" width="520" height="42" as="geometry" />
        </mxCell>
        <mxCell id="3" value="설명용 / 발화 포인트를 붙인 버전" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#475569;" parent="1" vertex="1">
          <mxGeometry x="44" y="68" width="420" height="26" as="geometry" />
        </mxCell>

        <mxCell id="10" value="1. 사용자 진입" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="170" width="260" height="220" as="geometry" />
        </mxCell>
        <mxCell id="11" value="사용자" style="shape=mxgraph.aws4.users;html=1;strokeColor=none;fillColor=#232F3E;gradientColor=none;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="100" y="242" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="12" value="외부에서는 하나의 공개 도메인으로 접근하고, 이 도메인을 기준으로 인증과 업무 API를 통합해서 설명하면 이해가 빠릅니다." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#e2e8f0;fontColor=#475569;fontSize=13;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="190" y="230" width="100" height="108" as="geometry" />
        </mxCell>

        <mxCell id="20" value="2. 공개 진입 계층" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#eff6ff;strokeColor=#60a5fa;fontColor=#0f172a;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="380" y="170" width="430" height="220" as="geometry" />
        </mxCell>
        <mxCell id="21" value="CloudFront" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;html=1;outlineConnect=0;gradientColor=#945DF2;gradientDirection=north;fillColor=#5A30B5;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="430" y="242" width="84" height="84" as="geometry" />
        </mxCell>
        <mxCell id="22" value="ALB" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;html=1;outlineConnect=0;gradientColor=#945DF2;gradientDirection=north;fillColor=#5A30B5;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="575" y="242" width="84" height="84" as="geometry" />
        </mxCell>
        <mxCell id="23" value="CloudFront는 공개 호스트를 담당하고, ALB는 실제 Ingress 트래픽을 EKS로 넘기는 역할로 설명하면 됩니다." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#93c5fd;fontColor=#1e3a8a;fontSize=13;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="690" y="228" width="95" height="110" as="geometry" />
        </mxCell>

        <mxCell id="30" value="3. EKS 애플리케이션 런타임" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#7c2d12;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="860" y="120" width="760" height="360" as="geometry" />
        </mxCell>
        <mxCell id="31" value="Amazon EKS" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;html=1;outlineConnect=0;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1190" y="155" width="88" height="88" as="geometry" />
        </mxCell>
        <mxCell id="32" value="AZ A&#xa;노드 그룹 + 워크로드" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#fdba74;fontColor=#7c2d12;fontSize=15;fontStyle=1;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="920" y="280" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="33" value="AZ B&#xa;노드 그룹 + 워크로드" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#fdba74;fontColor=#7c2d12;fontSize=15;fontStyle=1;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1290" y="280" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="34" value="핵심 메시지&#xa;서비스는 EKS에서 동작하고, 공개 트래픽은 ALB를 통해 두 AZ의 노드로 분산됩니다." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fffaf0;strokeColor=#fdba74;fontColor=#7c2d12;fontSize=13;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="960" y="430" width="550" height="36" as="geometry" />
        </mxCell>

        <mxCell id="40" value="왜 2 AZ인가?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=18;fontStyle=1;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="470" width="360" height="56" as="geometry" />
        </mxCell>
        <mxCell id="41" value="1. 단일 AZ 장애가 나도 다른 AZ 노드에서 서비스 지속&#xa;2. ALB가 두 Public Subnet을 사용해 트래픽 우회 가능&#xa;3. 운영 관점에서 확장 / 점검 / 롤링 배포가 안정적&#xa;4. 레포 기준으로 Public / Private Subnet이 각각 2개이고, EKS는 private_subnet_ids 최소 2개를 요구" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#f8fafc;strokeColor=#0f172a;fontColor=#334155;fontSize=13;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="540" width="520" height="180" as="geometry" />
        </mxCell>

        <mxCell id="50" value="4. 공용 데이터 / 운영 연동" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#f0fdf4;strokeColor=#86efac;fontColor=#14532d;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1660" y="170" width="420" height="420" as="geometry" />
        </mxCell>
        <mxCell id="51" value="Aurora" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;html=1;outlineConnect=0;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1715" y="250" width="84" height="84" as="geometry" />
        </mxCell>
        <mxCell id="52" value="ElastiCache" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticache;html=1;outlineConnect=0;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1840" y="250" width="84" height="84" as="geometry" />
        </mxCell>
        <mxCell id="53" value="Amazon S3" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;html=1;outlineConnect=0;gradientColor=#60A337;gradientDirection=north;fillColor=#277116;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1965" y="250" width="84" height="84" as="geometry" />
        </mxCell>
        <mxCell id="54" value="DynamoDB" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;html=1;outlineConnect=0;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;fontColor=#232F3E;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1715" y="430" width="84" height="84" as="geometry" />
        </mxCell>
        <mxCell id="55" value="ECR / Secrets" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#86efac;fontColor=#14532d;fontSize=13;fontStyle=1;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1860" y="455" width="170" height="40" as="geometry" />
        </mxCell>

        <mxCell id="100" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#64748b;strokeWidth=2;" parent="1" source="11" target="21" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="101" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeColor=#2563eb;strokeWidth=2;" parent="1" source="21" target="22" edge="1">
          <mxGeometry relative="1" as="geometry" />
