        <mxCell id="44" value="Search Engine" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#334155;fontSize=13;fontStyle=1;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1030" y="955" width="160" height="40" as="geometry" />
