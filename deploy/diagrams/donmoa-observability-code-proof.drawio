        </mxCell>
        <mxCell id="40" value="발표 멘트 예시" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#f9fafb;strokeColor=#111827;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#111827;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="180" y="1060" width="1840" height="180" as="geometry" />
        </mxCell>
        <mxCell id="41" value="저희는 로깅 표준을 먼저 설계하고, 그 포맷이 실제로 남도록 설정 파일에 반영했습니다. 서비스 로그와 Nginx 로그를 JSON으로 통일하고 requestId, traceId를 이어서 수집기와 알림 규칙까지 연결했기 때문에, 지금은 장애가 나면 어느 구간에서 문제가 났는지 빠르게 좁히고 자동으로 감지할 수 있습니다." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontSize=22;fontColor=#334155;spacing=14;" parent="40" vertex="1">
          <mxGeometry x="28" y="52" width="1784" height="96" as="geometry" />
