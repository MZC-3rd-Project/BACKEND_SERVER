        </mxCell>
        <mxCell id="11" value="- 서비스 로그는 JSON으로 stdout에 출력&#xa;- edge-nginx access log도 JSON으로 맞춤&#xa;- Alloy가 둘 다 수집해서 Loki로 전송&#xa;- Grafana에서 서비스별 / 요청별 로그를 탐색" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=2;fontColor=#334155;fontSize=17;spacing=12;" parent="10" vertex="1">
          <mxGeometry x="24" y="60" width="572" height="124" as="geometry" />
        </mxCell>
        <mxCell id="20" value="2. 메트릭" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ecfdf5;strokeColor=#15803d;strokeWidth=3;fontColor=#166534;fontSize=22;fontStyle=1;spacing=14;" parent="1" vertex="1">
          <mxGeometry x="760" y="150" width="620" height="210" as="geometry" />
        </mxCell>
        <mxCell id="21" value="- Spring Boot Actuator가 /actuator/prometheus 노출&#xa;- Prometheus가 ServiceMonitor를 통해 30초 주기로 scrape&#xa;- Grafana에서 QPS, 에러율, p95, 리소스 사용량 대시보드 제공" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#86efac;strokeWidth=2;fontColor=#334155;fontSize=17;spacing=12;" parent="20" vertex="1">
          <mxGeometry x="24" y="60" width="572" height="124" as="geometry" />
        </mxCell>
        <mxCell id="30" value="3. 트레이스 상관관계" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=3;fontColor=#9a3412;fontSize=22;fontStyle=1;spacing=14;" parent="1" vertex="1">
          <mxGeometry x="1460" y="150" width="620" height="210" as="geometry" />
        </mxCell>
        <mxCell id="31" value="- Micrometer Tracing + Brave가 trace context를 만들고&#xa;- MdcTracingFilter가 traceId / spanId를 MDC에 넣고&#xa;- Logback JSON 로그가 그 값을 함께 출력해서 요청 단위 상관관계를 만든다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#fdba74;strokeWidth=2;fontColor=#334155;fontSize=17;spacing=12;" parent="30" vertex="1">
