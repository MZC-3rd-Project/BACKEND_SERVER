<mxfile host="app.diagrams.net" modified="2026-03-31T12:00:00Z" agent="Codex" version="24.7.17" type="device" compressed="false" pages="1">
  <diagram id="donmoa-gateway-one-slide-overview" name="Gateway One Slide Overview">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Gateway는 단순 프록시가 아니라 Edge + BFF + Security Boundary다" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=34;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
          <mxGeometry x="60" y="36" width="1800" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="client-gateway와 business-gateway를 기준으로, 이 계층이 맡는 역할을 한 장에서 설명하는 소개 슬라이드" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#475569;" parent="1" vertex="1">
          <mxGeometry x="160" y="88" width="1600" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="hero" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#DBEAFE;strokeColor=#93C5FD;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="610" y="140" width="700" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="heroTitle" value="Gateway" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1E3A8A;" parent="1" vertex="1">
          <mxGeometry x="760" y="166" width="400" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="heroBody" value="client-gateway + business-gateway&#xa;라우팅, 세션/보안 경계, BFF 조합, 사용자 경험 보호를 맡는 Edge 계층" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#1E3A8A;" parent="1" vertex="1">
          <mxGeometry x="670" y="204" width="580" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="card1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="80" y="320" width="840" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="card1Badge" value="역할 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="112" y="348" width="90" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="card1Title" value="Routing &amp; Entry" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
          <mxGeometry x="112" y="398" width="300" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="card1Body" value="- spring.cloud.gateway.routes로 도메인별 라우팅&#xa;- GatewayAuthRouteConfig로 auth/profile rewrite&#xa;- /ws/chat WebSocket route 제공&#xa;- client-gateway와 business-gateway로 사용 맥락 분리" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="112" y="446" width="760" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="card2" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="1000" y="320" width="840" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="card2Badge" value="역할 2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#16A34A;strokeColor=#16A34A;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1032" y="348" width="90" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="card2Title" value="Session &amp; Token Boundary" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
          <mxGeometry x="1032" y="398" width="420" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="card2Body" value="- GatewayLoginService가 OIDC login 완료 후 세션 생성&#xa;- refresh token은 암호화 + hash 후 Redis 세션에 저장&#xa;- 브라우저는 DONMOA_SESSION 쿠키만 가짐&#xa;- SessionHeaderRelayGlobalFilter가 signed context header를 downstream에 relay" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="1032" y="446" width="760" height="86" as="geometry"/>
        </mxCell>

        <mxCell id="card3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="80" y="580" width="840" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="card3Badge" value="역할 3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#D97706;strokeColor=#D97706;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="112" y="608" width="90" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="card3Title" value="BFF Orchestration" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
          <mxGeometry x="112" y="658" width="320" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="card3Body" value="- CatalogBffService: 검색 결과 + media URL 보강 + fallback&#xa;- CommerceReadBffService: funding / hot-deal / product 읽기 조합&#xa;- BusinessProductMediaBffService: 상품 생성/수정 + 이미지 연산 + 상세 재조회&#xa;- 클라이언트 복잡도를 gateway에서 흡수" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="112" y="706" width="760" height="86" as="geometry"/>
        </mxCell>

        <mxCell id="card4" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="1000" y="580" width="840" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="card4Badge" value="역할 4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#7C3AED;strokeColor=#7C3AED;fontColor=#FFFFFF;fontSize=16;fontStyle=1;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1032" y="608" width="90" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="card4Title" value="User Experience Protection" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
          <mxGeometry x="1032" y="658" width="420" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="card4Body" value="- WebClient timeout 설정으로 downstream 지연 제어&#xa;- SearchClickRelayService: 500ms timeout + best effort&#xa;- CatalogBffService: degrade fallback&#xa;- CatalogDetail/ProductMedia BFF: onErrorResume / fallback 응답" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#334155;" parent="1" vertex="1">
          <mxGeometry x="1032" y="706" width="760" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="whyBox" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#FEF3C7;strokeColor=#FCD34D;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="80" y="850" width="860" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="whyTitle" value="왜 WebFlux?" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#92400E;" parent="1" vertex="1">
          <mxGeometry x="114" y="878" width="220" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="whyBody" value="비동기 fan-out / fan-in, custom filter chain, reactive Redis session,&#xa;Spring Cloud Gateway routing, WebSocket 처리까지 한 계층에서 풀기 위해 WebFlux가 잘 맞는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#92400E;" parent="1" vertex="1">
          <mxGeometry x="114" y="920" width="780" height="38" as="geometry"/>
        </mxCell>

        <mxCell id="summaryBox" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#FDE68A;strokeColor=#F59E0B;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="980" y="850" width="860" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="summaryTitle" value="한 문장 정리" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#92400E;" parent="1" vertex="1">
          <mxGeometry x="1014" y="878" width="220" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="summaryBody" value="Gateway는 단순 경로 분기 계층이 아니라&#xa;라우팅 + 세션/보안 경계 + BFF 조합 + 사용자 경험 보호를 맡는 Edge 계층이다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#92400E;" parent="1" vertex="1">
          <mxGeometry x="1014" y="920" width="780" height="38" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
