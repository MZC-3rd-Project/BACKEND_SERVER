          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="실패 / 취소 / 만료" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#dc2626;strokeWidth=5;fontSize=12;fontColor=#991b1b;labelBackgroundColor=#ffffff;" parent="30" source="34" target="36" edge="1">
