        <mxCell id="40" value="Trade-off" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff7ed;strokeColor=#fdba74;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#9a3412;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="740" width="460" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="41" value="장점&#xa;초과 판매를 줄일 수 있다&#xa;결제 전에도 재고를 먼저 보호할 수 있다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#fed7aa;strokeWidth=1;fontColor=#334155;fontSize=18;spacing=12;" parent="40" vertex="1">
          <mxGeometry x="24" y="58" width="412" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="42" value="대신 reserved 상태, TTL, 복구 로직까지 직접 관리해야 해서 구조는 더 복잡해진다" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#fed7aa;strokeWidth=1;fontColor=#334155;fontSize=18;spacing=12;" parent="40" vertex="1">
          <mxGeometry x="24" y="148" width="412" height="54" as="geometry"/>
        </mxCell>

        <mxCell id="50" value="발표 멘트 예시" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#f9fafb;strokeColor=#111827;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#111827;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="580" y="860" width="1560" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="51" value="저희는 전체 분산 트랜잭션을 TCC로 푼 것이 아니라, 재고처럼 즉시 보호가 필요한 자원에만 TCC를 적용했습니다. 먼저 reserveOrderStock()으로 재고를 reserved 상태로 잡아두고, 결제가 완료되면 sold로 확정하고, 실패하거나 시간이 지나면 available로 복구하는 구조입니다." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontColor=#334155;fontSize=21;spacing=14;" parent="50" vertex="1">
          <mxGeometry x="24" y="34" width="1512" height="64" as="geometry"/>
        </mxCell>
