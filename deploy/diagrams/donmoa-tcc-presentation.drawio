<mxfile host="app.diagrams.net" modified="2026-03-30T02:00:00Z" agent="Codex" version="24.7.17" type="device" compressed="false" pages="1">
  <diagram id="tcc-presentation" name="TCC Presentation">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="2" value="DonMoa TCC Flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=32;fontStyle=1;fontColor=#111827;" parent="1" vertex="1">
          <mxGeometry x="40" y="24" width="620" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="재고가 필요한 구매는 먼저 예약하고, 결제 결과에 따라 확정하거나 복구하는 구조" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#4b5563;" parent="1" vertex="1">
          <mxGeometry x="44" y="70" width="920" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="10" value="적용 범위" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;fontSize=21;fontStyle=1;fontColor=#111827;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="130" width="2080" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="QUANTITY_BASED 구매 흐름에만 TCC 적용" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fff7ed;strokeColor=#fdba74;strokeWidth=1;fontColor=#9a3412;fontSize=19;fontStyle=1;spacing=10;" parent="10" vertex="1">
          <mxGeometry x="24" y="46" width="360" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="재고가 필요 없는 AMOUNT_BASED 흐름은 별도 처리" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1;fontColor=#334155;fontSize=19;spacing=10;" parent="10" vertex="1">
          <mxGeometry x="420" y="46" width="430" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="서비스 간 최종 상태 전파는 Saga로 분리" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=1;fontColor=#1e3a8a;fontSize=19;fontStyle=1;spacing=10;" parent="10" vertex="1">
          <mxGeometry x="886" y="46" width="370" height="42" as="geometry"/>
        </mxCell>

        <mxCell id="20" value="왜 TCC가 필요한가" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#1e3a8a;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="290" width="470" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="1. 결제 전에도 재고를 먼저 보호해야 함" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#bfdbfe;strokeWidth=1;fontColor=#334155;fontSize=18;spacing=10;" parent="20" vertex="1">
          <mxGeometry x="24" y="74" width="422" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="22" value="2. 하지만 아직 판매 완료로 확정할 수는 없음" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#bfdbfe;strokeWidth=1;fontColor=#334155;fontSize=18;spacing=10;" parent="20" vertex="1">
          <mxGeometry x="24" y="150" width="422" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="23" value="3. 결제 결과에 따라 확정 또는 복구가 필요함" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#bfdbfe;strokeWidth=1;fontColor=#334155;fontSize=18;spacing=10;" parent="20" vertex="1">
          <mxGeometry x="24" y="226" width="422" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="24" value="즉시 잠가야 하지만 아직 최종 확정은 못 하는 자원에 적합한 패턴" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#dbeafe;strokeColor=#60a5fa;strokeWidth=1;fontColor=#1e3a8a;fontSize=18;spacing=12;" parent="20" vertex="1">
          <mxGeometry x="24" y="316" width="422" height="62" as="geometry"/>
        </mxCell>

        <mxCell id="30" value="핵심 흐름" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;fontSize=22;fontStyle=1;fontColor=#111827;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="580" y="290" width="1560" height="540" as="geometry"/>
