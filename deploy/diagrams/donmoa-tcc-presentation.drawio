        <mxCell id="31" value="상품 검증" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontColor=#334155;fontSize=20;fontStyle=1;spacing=10;" parent="30" vertex="1">
          <mxGeometry x="40" y="228" width="170" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="32" value="orderId 선발급" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontColor=#334155;fontSize=20;fontStyle=1;spacing=10;" parent="30" vertex="1">
          <mxGeometry x="270" y="228" width="190" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="33" value="Try&#xa;reserveOrderStock()&#xa;available → reserved&#xa;orderId + expiresAt + idempotencyKey" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#fff7ed;strokeColor=#fdba74;strokeWidth=2;fontColor=#9a3412;fontSize=19;fontStyle=1;spacing=10;" parent="30" vertex="1">
          <mxGeometry x="520" y="200" width="300" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="34" value="구매 저장 / 주문 생성 / 결제 진행" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontColor=#334155;fontSize=20;fontStyle=1;spacing=10;" parent="30" vertex="1">
          <mxGeometry x="890" y="228" width="290" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="35" value="Confirm&#xa;PAYMENT_COMPLETED&#xa;reserved → sold" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ecfdf5;strokeColor=#86efac;strokeWidth=2;fontColor=#166534;fontSize=19;fontStyle=1;spacing=10;" parent="30" vertex="1">
          <mxGeometry x="1260" y="108" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="36" value="Cancel / Expire&#xa;FAILED / CANCELLED / TIMED_OUT&#xa;또는 TTL 만료&#xa;reserved → available" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#fef2f2;strokeColor=#fca5a5;strokeWidth=2;fontColor=#991b1b;fontSize=19;fontStyle=1;spacing=10;" parent="30" vertex="1">
