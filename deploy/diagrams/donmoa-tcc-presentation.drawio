        </mxCell>

        <mxCell id="37" value="Stock Service 내부 정합성은 동기 TCC로 보호" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1;fontColor=#334155;fontSize=18;spacing=12;" parent="30" vertex="1">
