        <mxCell id="38" value="이후 서비스 간 상태 전파는 payment-events 기반 Saga로 분리" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1;fontColor=#334155;fontSize=18;spacing=12;" parent="30" vertex="1">
          <mxGeometry x="780" y="404" width="720" height="50" as="geometry"/>
        </mxCell>

